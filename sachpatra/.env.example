# ==============================================================================
# SachPatra Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env
# DO NOT commit actual API keys or secrets to git.
# ==============================================================================

# Optional: Google Gemini API Key for multimodal image OCR and elder-friendly plain summaries.
# If omitted or unset, SachPatra functions 100% in offline deterministic rules mode.
GEMINI_API_KEY=

# Optional: Gemini model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Server listening port (default: 8000 for local, 10000 on Render)
PORT=8000

# Optional: SQLite statistics database path (stores aggregate counters only, zero PII)
STATS_DB_PATH=data/stats.db
